{
  "manifest_version": 3,
  "name": "IDS Yardımcısı",
  "description": "Invisalign Doctor Site'ta kayıtlı formdan reçeteyi doldurur (yetişkin, ergen, çocuk paketleri ve refinement), hasta fotoğraflarını, röntgeni ve CBCT'yi klasörden yükler, Dentsoft hasta kartından kimlik bilgilerini IDS Yeni hasta formuna taşır.",
  "version": "0.34.2",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://firestore.googleapis.com/*",
    "https://raw.githubusercontent.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.bundle.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vip.invisalign.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://vip.invisalign.com/*"
      ],
      "js": [
        "update.js",
        "folder.js",
        "exif.js",
        "crop.js",
        "content.js",
        "rx.js",
        "portrait.js",
        "xray.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://auto.smarthub.invisalign.com/*"
      ],
      "js": [
        "update.js",
        "folder.js",
        "cbct.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://clinic.dentsoft.com.tr/*"
      ],
      "js": [
        "dentsoft.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "IDS Yardımcısı ayarları"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "bridge.html",
        "bridge.js",
        "folder.js"
      ],
      "matches": [
        "https://vip.invisalign.com/*",
        "https://auto.smarthub.invisalign.com/*"
      ]
    }
  ]
}
